# Port the inference-service API + admin UI listens on.
PORT=4001

# Signing secret for JWT auth tokens (admin UI login sessions). Generate a
# long random value for real use, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Bootstrap admin account, created automatically on first boot if the users
# table is empty. Change the password after your first login.
ADMIN_EMAIL="admin@structai.local"
ADMIN_PASSWORD="change-me-on-first-login"

# --- Chat / analysis provider ---
# LLM_PROVIDER is "openai_compatible" (any endpoint speaking the OpenAI
# chat-completions protocol — by default the local vLLM sidecar below, this
# service NEVER imports vllm itself, only speaks HTTP to it; also works with
# LM Studio, Ollama's own OpenAI-compat endpoint, or a real cloud API given an
# API key) or "gemini" (Google's cloud API, needs GEMINI_API_KEY). Configure
# the active provider/model/baseUrl/key from the admin UI (public/admin)
# instead of here once the service is running — these are only the initial
# bootstrap defaults.
#
# Dev (Mac, via vllm-metal — see README.md):
#   source ~/.venv-vllm-metal/bin/activate
#   vllm serve <chat-model> --port 8001
#   vllm serve Qwen/Qwen3-Embedding-0.6B --port 8002 --runner pooling
#
# Prod (Linux + GPU): the app (app/config/docker-compose.app.yml) and the
# vLLM sidecars (config/docker-compose.yml) are two SEPARATE Compose stacks,
# started/stopped independently, sharing no Docker network — the app runs
# with `network_mode: host` and reaches the sidecars the same way as here in
# dev, via localhost + the ports config/docker-compose.yml publishes (8001, 8002).
LLM_PROVIDER="openai_compatible"
LLM_BASE_URL="http://localhost:8001/v1"
LLM_MODEL="Qwen/Qwen3-4B-Instruct-2507"
LLM_TEMPERATURE=0.1

# Only used as an initial bootstrap value when LLM_PROVIDER=gemini above; the
# active key is otherwise entered from the admin UI and never exposed back in
# plaintext (GET /api/config/llm only ever returns hasApiKey: true/false).
GEMINI_API_KEY=""

# --- Embeddings — always served by the vLLM sidecar (no cloud provider wired up) ---
EMBEDDING_BASE_URL="http://localhost:8002/v1"
EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"

# Where SQLite (users, api keys, llm/embedding config, instruments) and the
# Chroma persistent index are stored.
DB_PATH="./data/inference-service.db"
CHROMA_PATH="./data/chroma"

DEBUG=false
