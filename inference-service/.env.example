# Port the inference-service API + admin UI listens on.
PORT=4001

# Signing secret for JWT auth tokens (admin UI login sessions). Generate a
# long random value for real use, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Bootstrap admin account, created automatically on first boot if the users
# table is empty. Change the password after your first login.
ADMIN_EMAIL="admin@structai.local"
ADMIN_PASSWORD="change-me-on-first-login"

# --- vLLM sidecars ---
# This service NEVER imports vllm itself — it only ever speaks HTTP to two
# independently-run `vllm serve` processes (OpenAI-compatible API), one for
# chat/analysis and one for embeddings. Configure the active baseUrl/model
# from the admin UI (public/admin) instead of here once the service is
# running — these are only the initial bootstrap defaults.
#
# Dev (Mac, via vllm-metal — see README.md):
#   source ~/.venv-vllm-metal/bin/activate
#   vllm serve <chat-model> --port 8001
#   vllm serve Qwen/Qwen3-Embedding-0.6B --port 8002 --runner pooling
#
# Prod (Linux + GPU, via docker-compose.yml): vllm-chat and vllm-embed
# services on the docker-compose network, e.g. http://vllm-chat:8000/v1.
LLM_BASE_URL="http://localhost:8001/v1"
LLM_MODEL="Qwen/Qwen3-4B-Instruct-2507"
LLM_TEMPERATURE=0.1
EMBEDDING_BASE_URL="http://localhost:8002/v1"
EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"

# Where SQLite (users, api keys, llm/embedding config, instruments) and the
# Chroma persistent index are stored.
DB_PATH="./data/inference-service.db"
CHROMA_PATH="./data/chroma"

DEBUG=false
