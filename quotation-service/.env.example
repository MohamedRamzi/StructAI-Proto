# Port the quotation-service API + admin UI listens on.
PORT=4001

# Signing secret for JWT auth tokens (admin UI login sessions). Generate a
# long random value for real use, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Bootstrap admin account, created automatically on first boot if the users
# table is empty. Change the password after your first login.
ADMIN_EMAIL="admin@structai.local"
ADMIN_PASSWORD="change-me-on-first-login"

# Gemini API key used when the LLM config's provider is "gemini". Configure
# the active provider/model/key from the admin UI (public/admin) instead of
# here once the service is running — this is only the initial fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Path to the SQLite database file (users, LLM settings, API keys).
DB_PATH="./data/quotation-service.db"

# Set to "true" to log full LLM prompts/responses to the console.
DEBUG_LLM=false
