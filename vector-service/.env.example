# Port the vector-service API + admin UI listens on.
PORT=4002

# Signing secret for JWT auth tokens (admin UI login sessions). Generate a
# long random value for real use, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Bootstrap admin account, created automatically on first boot if the users
# table is empty. Change the password after your first login.
ADMIN_EMAIL="admin@structai.local"
ADMIN_PASSWORD="change-me-on-first-login"

# Ollama server used to compute embeddings (Qwen3-Embedding). Configure the
# active model from the admin UI (public/admin) instead of here once the
# service is running — this is only the initial bootstrap default.
OLLAMA_URL="http://localhost:11434"
EMBEDDING_MODEL="qwen3-embedding"

# Where SQLite (users, api keys, instruments) and the Chroma persistent
# index are stored.
DB_PATH="./data/vector-service.db"
CHROMA_PATH="./data/chroma"

DEBUG=false
