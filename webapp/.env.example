# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Port the main StructAI app (Express + Vite) listens on. Defaults to 3000.
PORT=3000
NODE_ENV=development
DEBUG_LLM=false
VITE_DEBUG_LLM=false

# --- inference-service integration ---
# Both the NLP analysis (prompt + LLM call, missing-field detection) and the
# qualitative/semantic underlying search (embeddings + ChromaDB) are delegated
# to the standalone inference-service (see inference-service/) over HTTP — a
# single Python/FastAPI service backed by vLLM sidecars. Start it separately
# (npm run dev in inference-service/, or `npm run dev:all` from the repo root
# to launch it together with its two vLLM sidecars and the main app), then
# generate a service API key from its admin UI
# (http://localhost:4001/admin/login.html -> Clés API) and paste it below.
INFERENCE_SERVICE_URL=http://localhost:4001
INFERENCE_SERVICE_API_KEY="MY_INFERENCE_SERVICE_API_KEY"

# Only used by scripts/seed-vector-service.ts (an admin JWT login, not the
# read-only search/analyze API key above — write routes reject service API
# keys on purpose, see inference-service/README.md). Matches
# inference-service/.env's ADMIN_EMAIL / ADMIN_PASSWORD.
INFERENCE_SERVICE_ADMIN_EMAIL="admin@structai.local"
INFERENCE_SERVICE_ADMIN_PASSWORD="MY_INFERENCE_SERVICE_ADMIN_PASSWORD"
