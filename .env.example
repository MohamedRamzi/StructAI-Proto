# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Port the main StructAI app (Express + Vite) listens on. Defaults to 3000.
PORT=3000
NODE_ENV=development
DEBUG_LLM=false
VITE_DEBUG_LLM=false

# --- quotation-service integration ---
# The NLP analysis (prompt + LLM call, missing-field detection) is delegated to
# the standalone quotation-service (see quotation-service/) over HTTP. Start it
# separately (npm run dev in quotation-service/, or `npm run dev:all` from the
# repo root to launch both together), then generate a service API key from its
# admin UI (http://localhost:4001/admin/login.html -> Clés API) and paste it below.
LLM_SERVICE_URL=http://localhost:4001
LLM_SERVICE_API_KEY="MY_QUOTATION_SERVICE_API_KEY"

# --- vector-service integration ---
# The qualitative/semantic underlying search (real embeddings + ChromaDB) is
# delegated to the standalone vector-service (see vector-service/) over HTTP.
# Start it separately (python run.py in vector-service/, or `npm run dev:all`
# from the repo root), then generate a service API key from its admin UI
# (http://localhost:4002/admin/login.html -> Clés API) and paste it below.
VECTOR_SERVICE_URL=http://localhost:4002
VECTOR_SERVICE_API_KEY="MY_VECTOR_SERVICE_API_KEY"

# Only used by scripts/seed-vector-service.ts (an admin JWT login, not the
# read-only search API key above — write routes reject service API keys on
# purpose, see vector-service/README.md). Matches vector-service/.env's
# ADMIN_EMAIL / ADMIN_PASSWORD.
VECTOR_SERVICE_ADMIN_EMAIL="admin@structai.local"
VECTOR_SERVICE_ADMIN_PASSWORD="MY_VECTOR_SERVICE_ADMIN_PASSWORD"
